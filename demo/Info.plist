<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>IPATDemo</string>
	<key>CFBundleIdentifier</key>
	<string>com.ipatool.demo</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>IPATDemo</string>
	<key>CFBundleDisplayName</key>
	<string>注入验证</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>14.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>IPATSceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- AnyVpn.dylib 的初始配置。优先级：面板里保存的连接（NSUserDefaults）
	     > 这里的值（AnyVpn.m 的 configured:）。所以这里留空也能测：
	     打开 App → 右侧悬浮窗 →「VPN 隧道」→「＋ 添加连接」填网关信息即可。
	     字段含义：
	       Server        网关地址（必填）
	       User          账号
	       Password      密码
	       AuthGroup     认证组（留空 = 自动选第一个）
	       DisableDTLS   true = 只走 CSTP(TCP)。DTLS/UDP 443 在多数网络握不上手，
	                      真机测试建议直接 true
	       UnderlyingIface en0 = openconnect 的 socket 绑到底层网卡，防路由环路
	       AutoConnect   true = 启动即连（默认 false，避免一启动就弹网关登录）
	       TotpSecret    Base32 TOTP 密钥（可选；账号级密钥优先）
	       TunnelDNS     覆盖网关下发的隧道 DNS，"ip1,ip2"（网关 DNS 不服务时用） -->
	<key>IPAToolAnyVpn</key>
	<dict>
		<key>Server</key>
		<string></string>
		<key>User</key>
		<string></string>
		<key>Password</key>
		<string></string>
		<key>AuthGroup</key>
		<string></string>
		<key>DisableDTLS</key>
		<true/>
		<key>UnderlyingIface</key>
		<string>en0</string>
		<key>AutoConnect</key>
		<false/>
	</dict>
</dict>
</plist>
